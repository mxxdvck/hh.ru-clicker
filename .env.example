# Скопируй как .env и заполни. НЕ используй значение "change-me" в проде —
# ключ должен быть непредсказуемым, иначе LAN-доступ равносилен отсутствию auth.
# Сгенерируй сильный ключ: `openssl rand -hex 32` или `python -c 'import secrets;print(secrets.token_urlsafe(32))'`
# Пустое значение (или отсутствие переменной) → web_app.py откажется биндиться на 0.0.0.0.
HH_BOT_API_KEY=
# UID/GID пользователя хоста, которому должны принадлежать data/*.json.
# Узнать значения: id -u; id -g
HH_BOT_UID=1000
HH_BOT_GID=1000

# Encryption at rest for config/accounts/sessions/OAuth tokens.
# Windows uses DPAPI automatically. On Linux/server set a long random key.
HH_BOT_DATA_KEY=
# Fail startup/writes instead of falling back to plaintext when encryption is unavailable.
HH_BOT_REQUIRE_ENCRYPTION=0

# Project Phase 6: Telegram remote. Disabled unless explicitly enabled.
# Token is a secret and must stay in environment only (never data/config.json).
HH_BOT_TELEGRAM_ENABLED=0
HH_BOT_TELEGRAM_TOKEN=
# Comma-separated positive PRIVATE chat ids. Groups/channels are rejected.
HH_BOT_TELEGRAM_ALLOWED_CHAT_IDS=
